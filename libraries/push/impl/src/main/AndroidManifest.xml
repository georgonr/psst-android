<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- PSST (D87): REQUEST_IGNORE_BATTERY_OPTIMIZATIONS removed — Google Play does not allow it for chat apps that use FCM
         (developer.android.com/training/monitoring-device-state/doze-standby#exemption-cases). -->
    <!-- PSST (D73): wake the screen for a new message (special app access "Turn screen on", Android 14+) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.TURN_SCREEN_ON" />

    <application>
        <service android:name=".push.FetchPushForegroundService"
            android:foregroundServiceType="shortService"
            android:exported="false"
            android:enabled="true" />

        <receiver
            android:name=".notifications.TestNotificationReceiver"
            android:exported="false" />
        <receiver
            android:name=".notifications.NotificationBroadcastReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- PSST (D72): Settings → "Upozornenia a hovory" (toggles with the real system state) -->
        <activity
            android:name=".psst.PsstNotificationsCallsActivity"
            android:exported="false"
            android:label="psst"
            android:theme="@android:style/Theme.DeviceDefault.Light" />
        <!-- PSST (D67): Settings → Notifications → notification diagnostics. No NotificationListenerService (D83): Play Protect
             blocks sideloaded apps that declare one. -->
        <activity
            android:name=".psst.PsstNotificationDiagnosticsActivity"
            android:exported="false"
            android:label="psst"
            android:theme="@android:style/Theme.DeviceDefault.Light" />

        <provider
            android:name=".notifications.NotificationsFileProvider"
            android:authorities="${applicationId}.notifications.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/notifications_provider_paths" />
        </provider>

    </application>

</manifest>
